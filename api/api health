import json

def handler(request):
    try:
        data = json.loads(request.body)

        amount = data.get("amount", 0)

        # Simple fraud rule
        if amount > 100000:
            result = "Fraud"
        else:
            result = "Legit"

        return {
            "statusCode": 200,
            "body": json.dumps({"result": result})
        }

    except Exception as e:
        return {
            "statusCode": 500,
            "body": str(e)
        }

